# ==============================================================================
# NICEONE OIS — SOCIAL DATA / PUBLISHING PROVIDERS
# ==============================================================================
# SECURITY:
# - Copy this file to .env locally.
# - NEVER commit .env or real credentials.
# - .gitignore already excludes .env and other .env.* files while allowing
#   .env.example.
# - Store production secrets in the deployment secret manager, not Git.
#
# Provider status:
#   EulerStream       = API key available
#   TikTok Developer  = client credentials available
#   Exolyt            = account available; API credential/endpoint must be
#                        confirmed from the Exolyt account/API offering
#   Pentos            = account available; API credential/endpoint must be
#                        confirmed from the Pentos account/API offering
#   SociaVault        = API key required
#   Bundle Social     = API key required
#   RapidAPI          = API key required
#
# Empty values below are intentional placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# EULERSTREAM — TikTok LIVE / realtime data
# Docs: https://www.eulerstream.com/docs/api/quickstart
# ------------------------------------------------------------------------------
EULERSTREAM_API_KEY=
EULERSTREAM_BASE_URL=https://www.eulerstream.com

# ------------------------------------------------------------------------------
# EXOLYT — TikTok analytics / intelligence
# Account: https://app.exolyt.com/account
# Keep endpoint configurable until the account/API contract is confirmed.
# ------------------------------------------------------------------------------
EXOLYT_API_KEY=
EXOLYT_BASE_URL=

# ------------------------------------------------------------------------------
# PENTOS — TikTok/social trend and competitor intelligence
# Account: https://www.pentos.ai/
# Keep endpoint configurable until the account/API contract is confirmed.
# ------------------------------------------------------------------------------
PENTOS_API_KEY=
PENTOS_BASE_URL=

# ------------------------------------------------------------------------------
# SOCIAVAULT — multi-platform social data API
# Docs: https://docs.sociavault.com/development
# Authentication: X-API-Key
# ------------------------------------------------------------------------------
SOCIAVAULT_API_KEY=
SOCIAVAULT_BASE_URL=https://api.sociavault.com

# ------------------------------------------------------------------------------
# BUNDLE.SOCIAL — publishing / social account API
# Docs: https://bundle.social/instagram-api
# Authentication: x-api-key
# ------------------------------------------------------------------------------
BUNDLE_SOCIAL_API_KEY=
BUNDLE_SOCIAL_BASE_URL=https://api.bundle.social/api/v1
BUNDLE_SOCIAL_TEAM_ID=

# ------------------------------------------------------------------------------
# RAPIDAPI — Instagram Scraper Stable API
# Marketplace: https://rapidapi.com/thetechguy32744/api/instagram-scraper-stable-api
# Authentication uses X-RapidAPI-Key + X-RapidAPI-Host.
# ------------------------------------------------------------------------------
RAPIDAPI_KEY=
RAPIDAPI_HOST_INSTAGRAM_SCRAPER=instagram-scraper-stable-api.p.rapidapi.com

# ------------------------------------------------------------------------------
# TIKTOK FOR DEVELOPERS — official TikTok APIs
# Docs: https://developers.tiktok.com/
# Client credentials are server-side secrets.
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Optional user-authorized token state. Do not put short-lived tokens here in
# production; persist them in a secure token store instead.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# Optional Research / Commercial Content API client token cache.
# TikTok documents client access tokens as short-lived; generate/refresh at
# runtime from TIKTOK_CLIENT_KEY + TIKTOK_CLIENT_SECRET.
TIKTOK_CLIENT_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# OIS SOCIAL INGESTION RUNTIME
# ------------------------------------------------------------------------------
SOCIAL_INGESTION_ENABLED=false
SOCIAL_INGESTION_ENV=development
SOCIAL_INGESTION_TIMEOUT_SECONDS=30
SOCIAL_INGESTION_MAX_RETRIES=2
SOCIAL_INGESTION_REQUIRE_EVIDENCE=true
SOCIAL_INGESTION_DRY_RUN=true

# ------------------------------------------------------------------------------
# OIS SECURITY / OBSERVABILITY
# ------------------------------------------------------------------------------
SECRETS_PROVIDER=env
LOG_REDACT_SECRETS=true
AUDIT_EXTERNAL_API_CALLS=true
