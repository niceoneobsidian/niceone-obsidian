# ==============================================================================
# NICEONE OBSIDIAN — OIS v2 HYBRID
# CANONICAL INTEGRATION ENVIRONMENT CONTRACT
# ==============================================================================
# Safe-by-default canonical runtime surface.
#
# Authority boundaries:
#   .env              = runtime configuration
#   registries        = provider/adapter/capability/tool architecture
#   policy engine     = authorization
#   credential resolver = secret materialization
#   contracts         = behavior
#   conformance       = trust/evidence
#
# IMPORTANT:
#   This canonical file MUST NOT enable external calls, writes, deletes,
#   publishing, or live conformance tests.
#
# Profiles:
#   .env.example = safe canonical contract
#   .env         = local runtime configuration (gitignored)
#   .env.test    = isolated tests
#   .env.live    = explicit protected live-test profile (gitignored)
#
# Boolean convention: true / false
# ==============================================================================

# ------------------------------------------------------------------------------
# 00 CORE RUNTIME
# ------------------------------------------------------------------------------
OIS_APP_NAME=Niceone-Obsidian
OIS_APP_VERSION=0.1.0
OIS_ENV=local
OIS_ENVIRONMENT=development
OIS_DEBUG=false
OIS_LOG_LEVEL=info
OIS_HOST=0.0.0.0
OIS_PORT=8000
OIS_API_BASE_PATH=/api/v1
OIS_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 01 SECURITY DEFAULTS
# ------------------------------------------------------------------------------
OIS_FAIL_CLOSED=true
OIS_ALLOW_EXTERNAL_CALLS=false
OIS_EXTERNAL_WRITE_ENABLED=false
OIS_EXTERNAL_DELETE_ENABLED=false
OIS_EXTERNAL_PUBLISH_ENABLED=false
OIS_EXTERNAL_ADMIN_ACTIONS_ENABLED=false
OIS_REQUIRE_TLS=true
OIS_TLS_VERIFY=true
OIS_MAX_REQUEST_BODY_BYTES=10485760
OIS_MAX_RESPONSE_BYTES=10485760
OIS_SECRET_REDACTION_ENABLED=true
OIS_SECURITY_HEADERS_ENABLED=true
OIS_CORS_ENABLED=false
OIS_CORS_ALLOWED_ORIGINS=
OIS_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
OIS_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-Correlation-ID

# ------------------------------------------------------------------------------
# 02 INTEGRATION CONTROL PLANE
# ------------------------------------------------------------------------------
INTEGRATIONS_REQUIRE_REGISTRATION=true
INTEGRATIONS_REQUIRE_CAPABILITY=true
INTEGRATIONS_REQUIRE_POLICY=true
INTEGRATIONS_REQUIRE_TOOL_REGISTRY=true
INTEGRATIONS_REQUIRE_CREDENTIAL_RESOLUTION=true
INTEGRATIONS_FAIL_CLOSED=true
INTEGRATIONS_DEFAULT_TIMEOUT_MS=30000
INTEGRATIONS_DEFAULT_MAX_RETRIES=3
INTEGRATIONS_ALLOW_UNREGISTERED_PROVIDERS=false
INTEGRATIONS_ALLOW_UNREGISTERED_TOOLS=false
INTEGRATIONS_ALLOW_UNSCOPED_CAPABILITIES=false

