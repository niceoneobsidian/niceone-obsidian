```dotenv
# ==============================================================================
# NICEONE OIS — SOURCE FABRIC / SOCIAL DATA / PUBLISHING
# ==============================================================================
#
# SECURITY
# ------------------------------------------------------------------------------
# - Copy this file to .env for local development:
#       cp .env.example .env
# - NEVER commit .env or real credentials.
# - .gitignore excludes .env and other .env.* files while allowing this example.
# - Production secrets MUST come from the deployment secret manager.
# - Do not place production access/refresh tokens in source control.
# - Do not log credentials, authorization headers, OAuth codes, or bearer tokens.
#
# CONFIGURATION MODEL
# ------------------------------------------------------------------------------
#   Credentials / OAuth
#        ↓
#   Source adapters
#        ↓
#   Source Gateway
#        ↓
#   Evidence / provenance
#        ↓
#   OIS Control Plane / execution
#
# Provider credentials are intentionally blank.
# Add real values only to your local .env.
# ==============================================================================


# ==============================================================================
# OIS ENVIRONMENT
# ==============================================================================

OIS_ENV=development

# development | staging | production
OIS_LOG_LEVEL=INFO

# Whether external source integrations are enabled.
OIS_EXTERNAL_SOURCES_ENABLED=false

# Whether external publishing actions are enabled.
OIS_PUBLISHING_ENABLED=false


# ==============================================================================
# SOURCE GATEWAY — COMMON RUNTIME POLICY
# ==============================================================================

# Global timeout for outbound provider requests.
SOURCE_GATEWAY_TIMEOUT_SECONDS=30

# Number of retry attempts for retryable provider failures.
SOURCE_GATEWAY_MAX_RETRIES=2

# Backoff between retry attempts.
SOURCE_GATEWAY_RETRY_BACKOFF_SECONDS=1

# Require source evidence/provenance for externally sourced data.
SOURCE_GATEWAY_REQUIRE_EVIDENCE=true

# Prevent mutating/publishing operations during development.
SOURCE_GATEWAY_DRY_RUN=true

# Maximum number of records returned from a single source operation.
SOURCE_GATEWAY_MAX_RESULTS=100


# ==============================================================================
# GITHUB — SOURCE / REPOSITORY DATA
# ==============================================================================
#
# Authentication:
#   Personal access token / GitHub App credentials.
#
# Production recommendation:
#   Prefer GitHub App authentication for service-to-service workloads.
#   Keep tokens in the deployment secret manager.
# ==============================================================================

GITHUB_API_BASE_URL=https://api.github.com

# Optional token for local development.
GITHUB_TOKEN=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

# Optional GitHub App configuration.
GITHUB_APP_ID=5191898
GITHUB_APP_PRIVATE_KEY=SHA256:/9ohG90W0c9XIirY1w3J6CENyF+Ez4g3Mhzd88+z0+A=
GITHUB_APP_INSTALLATION_ID=Iv23liGS1gqzMSMhyLtN

# Optional default repository context.
GITHUB_OWNER=niceoneobsidian
GITHUB_REPOSITORY=niceone-obsidian


# ==============================================================================
# GOOGLE — SOURCE / WORKSPACE DATA
# ==============================================================================
#
# OAuth credentials are application credentials, not user access tokens.
# User authorization tokens should be generated and persisted by the OAuth/token
# subsystem rather than committed or permanently stored in this file.
# ==============================================================================

GOOGLE_API_BASE_URL=https://www.googleapis.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional local-development token state.
# Do not use these as production secret storage.
GOOGLE_ACCESS_TOKEN=AIzaSyBJwDL_PqpTgXMBcuyra2F7JqM_aP_IzEs
GOOGLE_REFRESH_TOKEN=


# ==============================================================================
# META / FACEBOOK / INSTAGRAM — SOURCE / PUBLISHING
# ==============================================================================
#
# Meta applications provide credentials for Facebook/Instagram integrations.
# Instagram publishing and data access depend on the Meta product/API and the
# authorization scopes granted to the connected account.
# ==============================================================================

META_API_BASE_URL=https://graph.facebook.com

META_APP_ID=2923427554684685|hZB_C-pPv3wDbca9LZXrrdBXzKA
META_APP_SECRET=EAApi14Tsbw0BSYwTUABRpdRmt4lGG9iEZAyPWaKf4LLAsmVCStYhjeldEZCaAqD5ul7NVjxmAfwZAZAKyG6IoejAjCeTOHn77Nqrg3MnOgyWukPmGXCsERRJZBs1e8VsOO23PVwxoxsERYAkfsZAQ3r1WjxxYcF06cPs4lqclzwQZC8i7OUoAfvduZCisB7ZChzUuX1HatCv5ZCrNh5ZA7f4Nzk8jIEwX262Av2ZAXMYM3xoV15TyBOr

META_REDIRECT_URI=

# Optional user/page/system-user access token for local development.
# Prefer secure token storage in production.
META_ACCESS_TOKEN=

# Optional identifiers used by Instagram/Facebook integrations.
META_BUSINESS_ACCOUNT_ID=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=


# ==============================================================================
# TIKTOK FOR DEVELOPERS — OFFICIAL TIKTOK APIs
# ==============================================================================
#
# Documentation:
#   https://developers.tiktok.com/
#
# Client credentials are server-side secrets.
# OAuth access/refresh tokens should be stored by the secure token subsystem
# in production rather than committed to .env.
# ==============================================================================

TIKTOK_API_BASE_URL=https://open.tiktokapis.com

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Optional local-development OAuth state.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# Optional Research / Commercial Content API client access token.
# These tokens are short-lived and should normally be generated at runtime.
TIKTOK_CLIENT_ACCESS_TOKEN=


# ==============================================================================
# EULERSTREAM — TIKTOK LIVE / REALTIME DATA
# ==============================================================================
#
# Docs:
#   https://www.eulerstream.com/docs/api/quickstart
# ==============================================================================

EULERSTREAM_API_KEY=
EULERSTREAM_BASE_URL=https://www.eulerstream.com


# ==============================================================================
# EXOLYT — TIKTOK ANALYTICS / INTELLIGENCE
# ==============================================================================
#
# Account:
#   https://app.exolyt.com/account
#
# Keep the endpoint configurable until the account/API contract is confirmed.
# ==============================================================================

EXOLYT_API_KEY=
EXOLYT_BASE_URL=


# ==============================================================================
# PENTOS — SOCIAL TREND / COMPETITOR INTELLIGENCE
# ==============================================================================
#
# Account:
#   https://www.pentos.ai/
#
# Keep the endpoint configurable until the account/API contract is confirmed.
# ==============================================================================

PENTOS_API_KEY=
PENTOS_BASE_URL=


# ==============================================================================
# SOCIAVAULT — MULTI-PLATFORM SOCIAL DATA
# ==============================================================================
#
# Authentication:
#   X-API-Key
#
# Docs:
#   https://docs.sociavault.com/development
# ==============================================================================

SOCIAVAULT_API_KEY=sk_live_3274d1d2db2787fb7bc928e54a04af2e
SOCIAVAULT_BASE_URL=https://api.sociavault.com


# ==============================================================================
# BUNDLE.SOCIAL — SOCIAL PUBLISHING
# ==============================================================================
#
# Authentication:
#   x-api-key
#
# Docs:
#   https://bundle.social/instagram-api
# ==============================================================================

BUNDLE_SOCIAL_API_KEY=9ad1ab92-ff35-43e1-980c-c14eb408285a
BUNDLE_SOCIAL_BASE_URL=https://api.bundle.social/api/v1
BUNDLE_SOCIAL_TEAM_ID=


# ==============================================================================
# RAPIDAPI — INSTAGRAM SCRAPER STABLE API
# ==============================================================================
#
# Authentication:
#   X-RapidAPI-Key
#   X-RapidAPI-Host
#
# Marketplace:
#   https://rapidapi.com/thetechguy32744/api/instagram-scraper-stable-api
# ==============================================================================

RAPIDAPI_KEY=fbbad9c9b0msh6511cbd4c988aadp1e6be9jsnb84bd525594b
RAPIDAPI_HOST_INSTAGRAM_SCRAPER=instagram-scraper-stable-api.p.rapidapi.com


# ==============================================================================
# SOCIAL INGESTION RUNTIME
# ==============================================================================

SOCIAL_INGESTION_ENABLED=false

# development | staging | production
SOCIAL_INGESTION_ENV=development

SOCIAL_INGESTION_TIMEOUT_SECONDS=30
SOCIAL_INGESTION_MAX_RETRIES=2

# Every externally sourced observation should retain provenance/evidence.
SOCIAL_INGESTION_REQUIRE_EVIDENCE=true

# Prevent writes/publishing while developing.
SOCIAL_INGESTION_DRY_RUN=true

# Maximum records accepted from a provider operation.
SOCIAL_INGESTION_MAX_RESULTS=100


# ==============================================================================
# SOCIAL PUBLISHING SAFETY
# ==============================================================================

# Publishing remains disabled unless explicitly enabled.
SOCIAL_PUBLISHING_ENABLED=false

# Always begin in dry-run mode.
SOCIAL_PUBLISHING_DRY_RUN=true

# Require explicit authorization before a publishing operation.
SOCIAL_PUBLISHING_REQUIRE_AUTHORIZATION=true

# Maximum publishing operations permitted by one execution.
SOCIAL_PUBLISHING_MAX_ACTIONS_PER_RUN=10


# ==============================================================================
# OIS SECURITY / SECRETS
# ==============================================================================

# Local development:
#   env
#
# Production:
#   replace with the deployment secret manager integration.
SECRETS_PROVIDER=env

# Never emit secrets in logs.
LOG_REDACT_SECRETS=true

# Never log Authorization/Bearer/API-key headers.
LOG_REDACT_AUTH_HEADERS=true

# Record metadata about outbound API calls without recording credentials.
AUDIT_EXTERNAL_API_CALLS=true


# ==============================================================================
# OAUTH / TOKEN SECURITY
# ==============================================================================

# Production token persistence must use a secure token store.
TOKEN_STORE=memory

# Never persist OAuth authorization codes in ordinary application logs.
OAUTH_REDACT_CODES=true

# Require state validation for OAuth callbacks.
OAUTH_REQUIRE_STATE=true


# ==============================================================================
# PHASE A LIVE-INTEGRATION TESTING
# ==============================================================================
#
# Keep live integration tests disabled by default.
#
# Enable explicitly when testing against real provider credentials:
#
#   OIS_LIVE_PHASE_A=1 pytest -q tests/integrations/test_live_cross_source_g1.py
#
# Individual providers should independently skip when their required
# credentials/configuration are unavailable.
# ==============================================================================

OIS_LIVE_PHASE_A=false

OIS_LIVE_GITHUB=false
OIS_LIVE_GOOGLE=false
OIS_LIVE_META=false
OIS_LIVE_TIKTOK=false

# Never allow live integration tests to perform publishing/mutations.
OIS_LIVE_ALLOW_MUTATIONS=false


# ==============================================================================
# OBSERVABILITY
# ==============================================================================

OTEL_ENABLED=false
OTEL_SERVICE_NAME=niceone-obsidian

# Configure only when an OTLP collector is available.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Do not include credentials or authorization headers in telemetry.
OTEL_REDACT_SECRETS=true
```
