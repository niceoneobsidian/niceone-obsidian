# Niceone Obsidian / OIS configuration contract
# Secret values are intentionally omitted. Local secrets belong in .env.local.
# Staging/production secrets must come from the deployment secret manager.

OIS_APP_NAME=niceone
OIS_ENVIRONMENT=local
OIS_CONFIG_PROFILE=local
OIS_DEBUG=true

OIS_EXTERNAL_APIS_ENABLED=false
OIS_EXTERNAL_READS_ENABLED=true
OIS_EXTERNAL_WRITES_ENABLED=false
OIS_REQUIRE_APPROVAL_FOR_EXTERNAL_ACTIONS=true
OIS_REQUIRE_CAPABILITY_EVIDENCE=true
OIS_REQUIRE_TOOL_HEALTH=true
OIS_REQUIRE_VALIDATION=true

OIS_EXECUTION_TIMEOUT_MS=300000
OIS_MAX_RETRIES=3

OIS_HTTP_TIMEOUT_MS=30000
OIS_HTTP_CONNECT_TIMEOUT_MS=5000
OIS_HTTP_MAX_CONNECTIONS=100
OIS_HTTP_MAX_CONNECTIONS_PER_HOST=20
OIS_HTTP_RETRY_ENABLED=true
OIS_HTTP_RETRY_BACKOFF_BASE_MS=250
OIS_HTTP_RETRY_BACKOFF_MAX_MS=10000
OIS_HTTP_CIRCUIT_BREAKER_ENABLED=true
OIS_HTTP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
OIS_HTTP_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

OIS_SECRET_PROVIDER=env
OIS_DATABASE_URL=
OIS_REDIS_URL=

OIS_MODEL_PROVIDER=
OIS_DEFAULT_MODEL=

OIS_OBSERVABILITY_ENABLED=true
OIS_TRACING_ENABLED=true
OIS_METRICS_ENABLED=true
OIS_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OIS_OTEL_EXPORTER_OTLP_INSECURE=true

META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

OIS_OAUTH_USE_PKCE=true
OIS_OAUTH_PKCE_METHOD=S256
OIS_OAUTH_STATE_TTL_SECONDS=600
OIS_OAUTH_REFRESH_ROTATION=true
OIS_OAUTH_REFRESH_REUSE_DETECTION=true

SOCIAL_INGESTION_ENABLED=false
SOCIAL_INGESTION_DRY_RUN=true
