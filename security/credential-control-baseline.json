{
  "schema_version": 1,
  "purpose": "OIS credential-control baseline for drift detection and release review",
  "required_controls": {
    "secret_scanning": "enabled",
    "raw_secret_logging": "disabled",
    "production_static_cloud_keys": "disabled",
    "workload_identity_required": "enabled",
    "deny_overrides_allow": "enabled",
    "rotation_requires_verification": "enabled",
    "evidence_hash_chaining": "enabled",
    "dependency_review": "enabled",
    "sbom_generation": "enabled",
    "full_history_secret_scan": "enabled"
  },
  "compliance_controls": [
    {
      "control_id": "OIS-SEC-001",
      "description": "Secrets are not stored in source code or metadata registries",
      "implementation_refs": ["ois/security/secrets/scanner.py", "ois/security/secrets/operator_cli.py"],
      "evidence_refs": [".github/workflows/security-hardening.yml"],
      "automated": true
    },
    {
      "control_id": "OIS-SEC-002",
      "description": "Credential lifecycle supports expiry, rotation and revocation",
      "implementation_refs": ["ois/security/secrets/api_platform.py", "ois/security/secrets/lifecycle_ops.py"],
      "evidence_refs": ["tests/security/test_lifecycle_ops.py"],
      "automated": true
    },
    {
      "control_id": "OIS-SEC-003",
      "description": "High-risk agent capabilities require authorization or approval",
      "implementation_refs": ["ois/security/secrets/agent.py"],
      "evidence_refs": ["tests/security/test_control_plane_hardening.py"],
      "automated": true
    },
    {
      "control_id": "OIS-SEC-004",
      "description": "Evidence integrity is verifiable and external immutable storage is adapter-backed",
      "implementation_refs": ["ois/security/secrets/evidence.py", "ois/security/secrets/lifecycle_ops.py"],
      "evidence_refs": ["tests/security/test_lifecycle_ops.py"],
      "automated": false
    },
    {
      "control_id": "OIS-SEC-005",
      "description": "Disaster recovery is exercised against declared RPO and RTO",
      "implementation_refs": ["ois/security/secrets/lifecycle_ops.py"],
      "evidence_refs": ["tests/security/test_lifecycle_ops.py"],
      "automated": true
    }
  ]
}
