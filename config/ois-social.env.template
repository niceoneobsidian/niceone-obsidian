# ==============================================================================
# NICEONE OIS — SOCIAL DATA / INTELLIGENCE / PUBLISHING ENVIRONMENT (TEMPLATE)
# ==============================================================================
#
# Committed, fail-closed DEFAULTS template. NOT loaded at runtime and must never
# contain real credentials. Verified in CI by
# tests/contract/test_env_example_contract.py.
# Your local .env and the temporary .env.example are separate files.
#
# External READS  -> explicitly enabled
# External WRITES -> explicitly enabled + policy/evidence/approval gated
# Publishing      -> disabled by default
# Production      -> deployment secret manager required
# ==============================================================================


# ==============================================================================
# 1. OIS ENVIRONMENT / RUNTIME IDENTITY
# ==============================================================================

OIS_ENVIRONMENT=development
OIS_DEBUG=false

# local | test | staging | production
OIS_RUNTIME_MODE=local

OIS_SERVICE_NAME=ois-social-runtime
OIS_SERVICE_VERSION=0.1.0
OIS_CONFIG_VERSION=1

# Fail startup when required configuration is missing or unsafe.
OIS_STARTUP_VALIDATION=true


# ==============================================================================
# 2. SECRET MANAGEMENT
# ==============================================================================

# env | vault | kubernetes | cloud
OIS_SECRET_PROVIDER=env

# Production MUST NOT rely on plaintext environment files.
OIS_REQUIRE_SECRET_PROVIDER=false

OIS_VAULT_ADDR=
OIS_VAULT_MOUNT=secret
OIS_VAULT_SOCIAL_PATH=ois/social
OIS_VAULT_AUTH_METHOD=

# Never log secrets.
LOG_REDACT_SECRETS=true
LOG_REDACT_TOKENS=true
LOG_REDACT_AUTH_HEADERS=true

# Prevent credential exposure in evidence / telemetry.
EVIDENCE_REDACT_SECRETS=true
TELEMETRY_REDACT_SECRETS=true


# ==============================================================================
# 3. EXTERNAL API SAFETY GATES
# ==============================================================================

EXTERNAL_APIS_ENABLED=false
EXTERNAL_API_READS_ENABLED=false
EXTERNAL_API_WRITES_ENABLED=false
SOCIAL_PUBLISHING_ENABLED=false
EXTERNAL_DESTRUCTIVE_OPERATIONS_ENABLED=false

# Dry-run protects development/test environments.
EXTERNAL_API_DRY_RUN=true
SOCIAL_PUBLISHING_DRY_RUN=true

# Require OIS policy/evidence validation before external writes.
EXTERNAL_WRITES_REQUIRE_POLICY=true
EXTERNAL_WRITES_REQUIRE_EVIDENCE=true
EXTERNAL_WRITES_REQUIRE_APPROVAL=true

# Environment-level write kill switch.
EXTERNAL_WRITE_KILL_SWITCH=true


# ==============================================================================
# 4. OIS SOCIAL INTELLIGENCE RUNTIME
# ==============================================================================

SOCIAL_INTELLIGENCE_ENABLED=true

SOCIAL_INGESTION_ENABLED=false
SOCIAL_INGESTION_ENV=development
SOCIAL_INGESTION_TIMEOUT_SECONDS=30
SOCIAL_INGESTION_MAX_RETRIES=2
SOCIAL_INGESTION_RETRY_BACKOFF_SECONDS=2
SOCIAL_INGESTION_MAX_BACKOFF_SECONDS=30
SOCIAL_INGESTION_REQUIRE_EVIDENCE=true
SOCIAL_INGESTION_REQUIRE_PROVENANCE=true
SOCIAL_INGESTION_REQUIRE_FRESHNESS=true


# ==============================================================================
# 5. SOCIAL DATA PROVIDER — EULERSTREAM
# ==============================================================================

EULERSTREAM_ENABLED=false
EULERSTREAM_BASE_URL=https://www.eulerstream.com
EULERSTREAM_API_KEY=
EULERSTREAM_TIMEOUT_SECONDS=30
EULERSTREAM_MAX_RETRIES=2
EULERSTREAM_READ_ENABLED=false
EULERSTREAM_WRITE_ENABLED=false


# ==============================================================================
# 6. SOCIAL INTELLIGENCE PROVIDER — EXOLYT
# ==============================================================================

EXOLYT_ENABLED=false
# Endpoint stays configurable until the account/API contract is confirmed.
EXOLYT_BASE_URL=
EXOLYT_API_KEY=
EXOLYT_TIMEOUT_SECONDS=30
EXOLYT_MAX_RETRIES=2
EXOLYT_READ_ENABLED=false
EXOLYT_WRITE_ENABLED=false


# ==============================================================================
# 7. SOCIAL INTELLIGENCE PROVIDER — PENTOS
# ==============================================================================

PENTOS_ENABLED=false
# Endpoint stays configurable until the account/API contract is confirmed.
PENTOS_BASE_URL=
PENTOS_API_KEY=
PENTOS_TIMEOUT_SECONDS=30
PENTOS_MAX_RETRIES=2
PENTOS_READ_ENABLED=false
PENTOS_WRITE_ENABLED=false


# ==============================================================================
# 8. SOCIAL DATA PROVIDER — SOCIAVAULT
# ==============================================================================

SOCIAVAULT_ENABLED=false
SOCIAVAULT_BASE_URL=https://api.sociavault.com
SOCIAVAULT_API_KEY=
SOCIAVAULT_TIMEOUT_SECONDS=30
SOCIAVAULT_MAX_RETRIES=2
SOCIAVAULT_READ_ENABLED=false
SOCIAVAULT_WRITE_ENABLED=false


# ==============================================================================
# 9. SOCIAL PUBLISHING PROVIDER — BUNDLE.SOCIAL
# ==============================================================================

BUNDLE_SOCIAL_ENABLED=false
BUNDLE_SOCIAL_BASE_URL=https://api.bundle.social/api/v1
BUNDLE_SOCIAL_API_KEY=
BUNDLE_SOCIAL_TEAM_ID=
BUNDLE_SOCIAL_TIMEOUT_SECONDS=30
BUNDLE_SOCIAL_MAX_RETRIES=2
BUNDLE_SOCIAL_READ_ENABLED=false
BUNDLE_SOCIAL_WRITE_ENABLED=false
# Publishing stays separately gated from general API writes.
BUNDLE_SOCIAL_PUBLISH_ENABLED=false
BUNDLE_SOCIAL_PUBLISH_DRY_RUN=true


# ==============================================================================
# 10. RAPIDAPI
# ==============================================================================

RAPIDAPI_ENABLED=false
RAPIDAPI_KEY=
RAPIDAPI_HOST_INSTAGRAM_SCRAPER=instagram-scraper-stable-api.p.rapidapi.com
RAPIDAPI_TIMEOUT_SECONDS=30
RAPIDAPI_MAX_RETRIES=2
RAPIDAPI_READ_ENABLED=false
RAPIDAPI_WRITE_ENABLED=false


# ==============================================================================
# 11. TIKTOK DEVELOPER PLATFORM
# ==============================================================================

TIKTOK_ENABLED=false
TIKTOK_BASE_URL=https://open.tiktokapis.com

# Server-side application credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

TIKTOK_TIMEOUT_SECONDS=30
TIKTOK_MAX_RETRIES=2
TIKTOK_READ_ENABLED=false
TIKTOK_WRITE_ENABLED=false

# TikTok OAuth
TIKTOK_OAUTH_ENABLED=false
TIKTOK_OAUTH_USE_PKCE=true
TIKTOK_OAUTH_PKCE_METHOD=S256
TIKTOK_TOKEN_ROTATION_ENABLED=true
TIKTOK_TOKEN_REUSE_DETECTION=true

# Do not persist short-lived tokens in source-controlled configuration.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# Prefer runtime generation from client credentials.
TIKTOK_CLIENT_ACCESS_TOKEN=


# ==============================================================================
# 12. SOCIAL PROVIDER ROUTING
# ==============================================================================

SOCIAL_PROVIDER_ROUTING_ENABLED=true
SOCIAL_PROVIDER_REGISTRY_REQUIRED=true
SOCIAL_REQUIRE_REGISTERED_PROVIDER=true
SOCIAL_REQUIRE_APPROVED_ENDPOINT=true
SOCIAL_PROVIDER_FALLBACK_ENABLED=true
SOCIAL_PROVIDER_MAX_FALLBACKS=2


# ==============================================================================
# 13. RATE LIMITING / RESILIENCE
# ==============================================================================

SOCIAL_RATE_LIMITING_ENABLED=true
SOCIAL_RATE_LIMIT_REQUESTS_PER_MINUTE=60
SOCIAL_CIRCUIT_BREAKER_ENABLED=true
SOCIAL_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SOCIAL_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
SOCIAL_RETRY_ENABLED=true
SOCIAL_RETRY_MAX_ATTEMPTS=2
SOCIAL_RETRY_TRANSIENT_ONLY=true


# ==============================================================================
# 14. HTTP / API FABRIC
# ==============================================================================

HTTP_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
HTTP_RETRY_ENABLED=true
HTTP_RETRY_TRANSIENT_ONLY=true
HTTP_VERIFY_TLS=true

# Do not follow arbitrary redirects for credential-bearing requests.
HTTP_ALLOW_AUTH_REDIRECTS=false


# ==============================================================================
# 15. EVIDENCE / PROVENANCE
# ==============================================================================

EVIDENCE_ENABLED=true
EVIDENCE_REQUIRED_FOR_EXTERNAL_DATA=true
PROVENANCE_ENABLED=true
PROVENANCE_REQUIRE_SOURCE_ID=true
PROVENANCE_REQUIRE_SOURCE_URL=true
PROVENANCE_REQUIRE_RETRIEVED_AT=true
PROVENANCE_REQUIRE_PROVIDER=true

# Preserve raw provider response only when policy permits.
RAW_SOURCE_CAPTURE_ENABLED=false
EVIDENCE_SECRET_REDACTION_ENABLED=true


# ==============================================================================
# 16. SOCIAL INTELLIGENCE QUALITY CONTROLS
# ==============================================================================

SOCIAL_DATA_VALIDATION_ENABLED=true
SOCIAL_REQUIRE_SCHEMA_VALIDATION=true
SOCIAL_REQUIRE_TIMESTAMP_VALIDATION=true
SOCIAL_REQUIRE_SOURCE_VALIDATION=true

# Reject stale data where freshness requirements are configured.
SOCIAL_REJECT_STALE_DATA=true
SOCIAL_MAX_SOURCE_AGE_SECONDS=86400


# ==============================================================================
# 17. PUBLISHING SAFETY
# ==============================================================================

PUBLISHING_ENABLED=false
PUBLISHING_REQUIRE_CAPABILITY=true
PUBLISHING_REQUIRE_POLICY=true
PUBLISHING_REQUIRE_APPROVAL=true
PUBLISHING_REQUIRE_EVIDENCE=true

# Prevent accidental duplicate publishing.
PUBLISHING_IDEMPOTENCY_ENABLED=true
PUBLISHING_REQUIRE_TARGET_VALIDATION=true

# Explicit emergency stop.
PUBLISHING_KILL_SWITCH=true


# ==============================================================================
# 18. OBSERVABILITY
# ==============================================================================

OTEL_ENABLED=true
OTEL_SERVICE_NAME=ois-social-runtime
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Never export credentials/tokens.
OTEL_REDACT_SECRETS=true

# Record provider execution metadata.
SOCIAL_TELEMETRY_ENABLED=true
SOCIAL_TELEMETRY_PROVIDER_EVENTS=true


# ==============================================================================
# 19. AUDIT
# ==============================================================================

AUDIT_ENABLED=true
AUDIT_EXTERNAL_API_CALLS=true
AUDIT_EXTERNAL_WRITES=true
AUDIT_PUBLISHING=true
AUDIT_POLICY_DECISIONS=true
AUDIT_CREDENTIAL_USAGE=true

# Never write secret values into audit logs.
AUDIT_REDACT_SECRETS=true


# ==============================================================================
# 20. DEVELOPMENT / TEST SAFETY
# ==============================================================================

DEV_EXTERNAL_APIS_ENABLED=false
DEV_EXTERNAL_API_WRITES_ENABLED=false
DEV_SOCIAL_PUBLISHING_ENABLED=false

# Test environment must never reach production provider credentials.
TEST_EXTERNAL_APIS_ENABLED=false
TEST_EXTERNAL_API_WRITES_ENABLED=false
TEST_SOCIAL_PUBLISHING_ENABLED=false
TEST_ISOLATE_CREDENTIALS=true
TEST_REQUIRE_MOCK_PROVIDERS=true
TEST_REJECT_PRODUCTION_CREDENTIALS=true


# ==============================================================================
# 21. PRODUCTION SAFETY
# ==============================================================================

# These values should be overridden by the deployment environment.
#
# Production should normally use:
#
# OIS_ENVIRONMENT=production
# OIS_SECRET_PROVIDER=vault
# OIS_REQUIRE_SECRET_PROVIDER=true
# EXTERNAL_APIS_ENABLED=true
# EXTERNAL_API_READS_ENABLED=true
# EXTERNAL_API_WRITES_ENABLED=false
# SOCIAL_PUBLISHING_ENABLED=false
#
# Writes/publishing should only be enabled after capability/policy/evidence/
# approval gates have passed.


# ==============================================================================
# 22. CONFIGURATION INTEGRITY
# ==============================================================================

CONFIG_SCHEMA_VALIDATION_ENABLED=true
CONFIG_STARTUP_VALIDATION_ENABLED=true
CONFIG_FAIL_ON_UNKNOWN_SETTINGS=false
CONFIG_FAIL_ON_MISSING_REQUIRED_SETTINGS=true
CONFIG_FAIL_ON_UNSAFE_PRODUCTION_SETTINGS=true
CONFIG_AUDIT_ENABLED=true


# ==============================================================================
# 23. OIS CAPABILITY ACTIVATION
# ==============================================================================

CAPABILITY_ACTIVATION_ENABLED=true

# Capability lifecycle: OFF -> SHADOW -> CANARY -> LIMITED -> PRODUCTION
CAPABILITY_REQUIRE_IMPLEMENTATION=true
CAPABILITY_REQUIRE_TESTS=true
CAPABILITY_REQUIRE_INTEGRATION=true
CAPABILITY_REQUIRE_POLICY=true
CAPABILITY_REQUIRE_ROLLBACK=true
CAPABILITY_REQUIRE_PRODUCTION_VERIFICATION=true

# Prevent configuration alone from activating capabilities.
CAPABILITY_CONFIG_CANNOT_BYPASS_GATES=true


# ==============================================================================
# 24. EMERGENCY CONTROLS
# ==============================================================================

# Emergency switches are evaluated before external execution.
OIS_GLOBAL_KILL_SWITCH=false
OIS_EXTERNAL_API_KILL_SWITCH=false
OIS_EXTERNAL_WRITE_KILL_SWITCH=true
OIS_PUBLISHING_KILL_SWITCH=true
OIS_PROVIDER_EXECUTION_KILL_SWITCH=false


# ==============================================================================
# END
# ==============================================================================
